# ============================================================
# 多源数据融合挖掘——房价预测
# 环境变量模板
# ============================================================
# 使用方式: cp .env.example .env 然后编辑 .env 填入实际值

# ========================
# 数据路径
# ========================
# Ames Housing Dataset CSV 文件路径
AMES_DATA_PATH=./data/raw/ames_train.csv

# Florida Real Estate Sold 2026 CSV 文件路径
FLORIDA_DATA_PATH=./data/raw/florida_sold_2026.csv

# ========================
# Kaggle API 配置（可选，用于自动下载数据）
# ========================
# KAGGLE_USERNAME=your_username
# KAGGLE_KEY=your_kaggle_api_key

# ========================
# 模型保存路径
# ========================
MODEL_SAVE_DIR=./models

# ========================
# 结果输出路径
# ========================
RESULTS_DIR=./results

# ========================
# 日志级别
# ========================
LOG_LEVEL=INFO

# ========================
# 随机种子（保证可复现性）
# ========================
SEED=42

# ========================
# 计算设备（auto 自动选择 GPU/CPU）
# ========================
DEVICE=auto

# ========================
# Hugging Face 镜像（国内用户可选）
# ========================
# HF_ENDPOINT=https://hf-mirror.com
